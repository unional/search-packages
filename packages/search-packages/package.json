{
	"name": "search-packages",
	"version": "2.1.0",
	"description": "Search packages on npm",
	"keywords": [
		"npm",
		"packages",
		"registry",
		"search"
	],
	"homepage": "https://github.com/unional/search-packages",
	"bugs": {
		"url": "https://github.com/unional/search-packages/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/unional/search-packages.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js",
		"require": "./cjs/index.js",
		"default": "./cjs/index.js"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.internal.*",
		"!**/*.{accept,integrate,spec,system,test,unit}.*"
	],
	"scripts": {
		"build": "run-p build:cjs build:esm",
		"build:cjs": "esbuild ts/index.ts --bundle --platform=node --outfile=cjs/index.js && ncp package.cjs.json cjs/package.json",
		"build:esm": "tsc",
		"build:watch": "tsc --watch",
		"clean": "rimraf .nyc_output .ts coverage cjs esm lib libm",
		"coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
		"verify": "npm-run-all clean -p build coverage depcheck",
		"watch": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --watch",
		"w": "pnpm watch"
	},
	"devDependencies": {
		"@repobuddy/jest": "^3.3.0",
		"@types/jest": "^29.5.14",
		"cross-env": "^7.0.3",
		"depcheck": "^1.4.7",
		"esbuild": "^0.27.0",
		"jest": "^29.7.0",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config-2": "^2.1.0",
		"jest-watch-typeahead": "^2.2.2",
		"ncp": "^2.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"ts-jest": "^29.4.11",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">= 18"
	}
}
